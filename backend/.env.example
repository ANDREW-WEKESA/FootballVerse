# FootballVerse environment configuration
# Copy this file to .env and fill in your values

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/footballverse

# Auth
JWT_SECRET=your-secret-key-here
ADMIN_EMAIL=admin@footballverse.com
ADMIN_PASSWORD=your-admin-password-here

# External APIs
FOOTBALL_DATA_API_KEY=your-football-data-api-key-here
